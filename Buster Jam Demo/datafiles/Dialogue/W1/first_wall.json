{"events":[],"comments":[{"text":"Before Frenzy","x":512.0,"y":240.0},{"text":"After Frenzy","x":1744.0,"y":240.0}],"camx":1150.2498779296875,"camy":609.75,"starting_node":-4.0,"textboxes":[{"text":"WOAH!","portrait_ind":2.0,"x":608.0,"y":512.0,"ID":0.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"The Wizard turned into stone!","portrait_ind":3.0,"x":464.0,"y":592.0,"ID":1.0,"connect0_ID":34.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"Pfft. Piece of cake. Leave it to me...","portrait_ind":0.0,"x":1344.0,"y":608.0,"ID":3.0,"portrait":-4.0},{"text":"<auto>Um...","portrait_ind":17.0,"x":640.0,"y":752.0,"ID":4.0,"portrait":"@ref sprite(spr_portrait_bridget)"},{"text":"Ough...","portrait_ind":24.0,"x":832.0,"y":752.0,"ID":5.0,"connect0_ID":22.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"Wait, that's a great idea!","portrait_ind":2.0,"x":816.0,"y":992.0,"ID":7.0,"connect0_ID":11.0,"portrait":"@ref sprite(spr_portrait_bridget)"},{"text":"Wuzzat?","portrait_ind":21.0,"x":912.0,"y":1104.0,"ID":11.0,"connect0_ID":13.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"Blowing it up! Yeah! We can just use the BOMs from work earlier to blow it up!","portrait_ind":0.0,"x":784.0,"y":1216.0,"ID":13.0,"connect0_ID":14.0,"portrait":"@ref sprite(spr_portrait_bridget)"},{"text":"Hey<nopause>, <yespause>hey! That's right!","portrait_ind":3.0,"x":768.0,"y":1328.0,"ID":14.0,"connect0_ID":25.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"LET'S HIT IT!","portrait_ind":1.0,"x":880.0,"y":1584.0,"ID":16.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"I'm pretty sure that's a statue...<break>I think? Hmmm.","portrait_ind":76.0,"x":752.0,"y":384.0,"ID":19.0,"connect0_ID":20.0,"portrait":"@ref sprite(spr_portrait_bridget)"},{"text":"Well, whatever it is, it's blocking the freakin' road.","portrait_ind":54.0,"x":1104.0,"y":384.0,"ID":20.0,"connect0_ID":21.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"Nothin' a little tornado can't handle. Leave it to me.","portrait_ind":26.0,"x":1152.0,"y":512.0,"ID":21.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"What's that? You wanna go?","portrait_ind":42.0,"x":1024.0,"y":768.0,"ID":22.0,"connect0_ID":23.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":".","portrait_ind":0.0,"x":1264.0,"y":768.0,"ID":23.0,"connect0_ID":24.0,"portrait":"@ref sprite(spr_portrait_wizardstatue)"},{"text":"Keep my mudda's name out 'ya mouth!","portrait_ind":43.0,"x":832.0,"y":848.0,"ID":24.0,"connect0_ID":35.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"Yo, ugly!<break>Buster: 1, Statue: 0.","portrait_ind":5.0,"x":912.0,"y":1424.0,"ID":25.0,"connect0_ID":26.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":".","portrait_ind":0.0,"x":992.0,"y":1504.0,"ID":26.0,"connect0_ID":16.0,"portrait":"@ref sprite(spr_portrait_wizardstatue)"},{"text":"Was he doing the splits?","portrait_ind":50.0,"x":1744.0,"y":320.0,"ID":27.0,"connect0_ID":28.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"That was AWESOME! You were so good back there, hun.","portrait_ind":6.0,"x":2000.0,"y":320.0,"ID":28.0,"connect0_ID":29.0,"portrait":"@ref sprite(spr_portrait_bridget)"},{"text":"I was great? Did you SEE yourself?","portrait_ind":3.0,"x":2352.0,"y":320.0,"ID":29.0,"connect0_ID":30.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"You was all like, BAM, BAM, BAM!","portrait_ind":5.0,"x":2368.0,"y":432.0,"ID":30.0,"connect0_ID":31.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"Aw, shucks... it was nothin'.","portrait_ind":88.0,"x":2096.0,"y":432.0,"ID":31.0,"connect0_ID":32.0,"portrait":"@ref sprite(spr_portrait_bridget)"},{"text":"We're makin' great time, too. The subway isn't too far from here.","portrait_ind":56.0,"x":1680.0,"y":432.0,"ID":32.0,"connect0_ID":33.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"Let's go!","portrait_ind":1.0,"x":1792.0,"y":560.0,"ID":33.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":"Bridget, we did it!","portrait_ind":41.0,"x":848.0,"y":592.0,"ID":34.0,"connect0_ID":19.0,"portrait":"@ref sprite(spr_portrait_buster)"},{"text":".","portrait_ind":0.0,"x":640.0,"y":864.0,"ID":35.0,"connect0_ID":36.0,"portrait":"@ref sprite(spr_portrait_wizardstatue)"},{"text":"<shake 2>I'LL BLOW 'YA TO BITS!!!","portrait_ind":44.0,"x":560.0,"y":960.0,"ID":36.0,"connect0_ID":7.0,"portrait":"@ref sprite(spr_portrait_buster)"}],"portraits":[],"cam_zoom_count":2.0,"choices":[],"ID_TOTAL":37.0}