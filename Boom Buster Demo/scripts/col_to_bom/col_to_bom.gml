function col_to_bom(arg0)
{
    switch (arg0)
    {
        case 0:
            return spr_bom_orange;
            break;
        
        case 1:
            return spr_bom_green;
            break;
        
        case 2:
            return spr_bom_purple;
            break;
        
        case 3:
            return spr_undefined;
            break;
    }
}
