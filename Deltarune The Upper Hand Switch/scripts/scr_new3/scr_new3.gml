function reset_to_default_all()
{
    op.superMode = false;
    op.party = ["kris", "susie", "ralsei"];
    op.custom_item = [5, 7, 6, 6, 4, 4, 4, 4, 4, 4, 4, 4];
    op.custom_enemyATK = 1;
    op.custom_partyATK = 1;
    op.custom_sparePower = 0;
    op.custom_airJumps = 1;
    op.custom_susieScared = true;
    op.custom_dt = true;
    op.custom_dtSec = 50;
    op.custom_dtDamage = 5;
    op.custom_dtPenalty = 1;
}
